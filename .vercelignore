# Files in this list never get uploaded to Vercel during deploy.
# Keep this in sync with .gitignore for anything secret-bearing.

.env
.env.local
.env.*.local

# Local-only operations / scripts not needed in production
scripts/
server/db/apply-migration-*.js
server/db/apply-schema-only.js
server/db/restore-grants.js
server/db/update-company-phone.js

# Docker — using Vercel instead
docker-compose.yml
server/Dockerfile

# Misc
*.log
.DS_Store
node_modules
client/dist
client/node_modules
server/node_modules
.git
