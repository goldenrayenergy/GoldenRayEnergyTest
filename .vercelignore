# Files in this list never get uploaded to Vercel during deploy.
# This deploy is FRONTEND-ONLY — the Express backend lives on Render.
# We exclude server/, scripts/, and DB migrations entirely so Vercel
# doesn't trace + bundle them.

.env
.env.local
.env.*.local

# Backend — deployed separately to Render via render.yaml
server/
scripts/

# Docker — using Vercel + Render instead
docker-compose.yml

# Misc
*.log
.DS_Store
node_modules
client/dist
client/node_modules
.git
