{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    { "source": "/qr/:slug",      "destination": "https://goldenray-api.onrender.com/qr/:slug" },
    { "source": "/qr/:slug/:rest*", "destination": "https://goldenray-api.onrender.com/qr/:slug/:rest*" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}
